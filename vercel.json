{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @family/web build",
  "devCommand": "pnpm --filter @family/web dev",
  "outputDirectory": "apps/web/.next",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "codex/family-intelligence-2026-10-02": true
    }
  }
}
