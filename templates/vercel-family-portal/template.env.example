# Public configuration
NEXT_PUBLIC_APP_NAME=Familienportal
NEXT_PUBLIC_DEFAULT_LOCALE=de

# Server-only gates. Values belong in Vercel, never in git.
FAMILY_AUTH_CONFIGURED=false
FAMILY_PORTAL_DEMO=false
FAMILY_DATABASE_URL=
FAMILY_OBJECT_STORE_ENDPOINT=
FAMILY_AUDIT_SIGNING_KEY=

# MCP gateway identity is server-bound. Use only agent or service_account.
FAMILY_MCP_DEMO=false
FAMILY_MCP_FAMILY_ID=
FAMILY_MCP_ACTOR_ID=
FAMILY_MCP_ACTOR_ROLE=agent

# Provider-specific keys are added only after threat-model review.
AUTH_SECRET=
